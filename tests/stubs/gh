#!/usr/bin/env python3
"""A stand-in for `gh api` in the scripts' tests: a small GitHub of one repository, held in the JSON file
$STUB_GH_STATE and changed by the calls that write, each call recorded in $STUB_GH_CALLS (one JSON a line). No network.

The state: repo ("owner/name"); tokens ({token: the App it acts as, `github-actions` for the job's token}); checks (check
runs, each with its head_sha and app slug); reviews ({number: [review]}); comments ({id: review comment}); pulls
({number: pull request}); permissions ({login: permission}); releases ({tag: GitHub release}); fail ([{method, path, status, times, made}]: the next calls whose
path starts so answer that status, 0 for no answer at all; with `made` the call is done first, and only its answer lost); on_create ({before, after: [check runs], rewrite: {..}}: what
other writers do around the next check run created). Its answers and errors are written as gh writes them: the body on
stdout, and on an error `gh: <message> (HTTP <status>)` on stderr with exit 1."""
import json
import os
import sys
import urllib.parse


def load() -> dict:
    with open(os.environ["STUB_GH_STATE"]) as f: return json.load(f)


def save(state: dict) -> None:
    with open(os.environ["STUB_GH_STATE"], "w") as f: json.dump(state, f, indent=1)


def record(call: dict) -> None:
    with open(os.environ["STUB_GH_CALLS"], "a") as f: f.write(json.dumps(call) + "\n")


def error(status: int, message: str) -> int:
    if status == 0:
        sys.stderr.write("error connecting to api.github.com\ncheck your internet connection or https://githubstatus.com\n"); return 1
    sys.stdout.write(json.dumps({"message": message, "status": str(status)}))
    sys.stderr.write(f"gh: {message} (HTTP {status})\n"); return 1


def new_check(state: dict, row: dict, app: str) -> dict:
    state["next_id"] = state.get("next_id", 1000) + 1
    check = {"id": state["next_id"], "name": row.get("name"), "head_sha": row.get("head_sha"), "status": row.get("status", "completed"),
             "conclusion": row.get("conclusion"), "output": row.get("output") or {"title": None, "summary": None}, "app": {"slug": row.get("app", app)}}
    state["checks"].append(check); return check


def route(state: dict, method: str, path: str, body, app: str):
    url = urllib.parse.urlsplit(path); parts = url.path.strip("/").split("/"); query = dict(urllib.parse.parse_qsl(url.query))
    if parts[:1] != ["repos"] or "/".join(parts[1:3]) != state["repo"]: return 404, "Not Found"
    rest = parts[3:]
    if method == "GET" and len(rest) == 3 and rest[0] == "commits" and rest[2] == "check-runs":
        rows = [c for c in state["checks"] if c["head_sha"] == rest[1] and (not query.get("check_name") or c["name"] == query["check_name"])]
        return 200, {"total_count": len(rows), "check_runs": rows}
    if method == "POST" and rest == ["check-runs"]:
        around = state.pop("on_create", None) or {}
        for row in around.get("before", []): new_check(state, row, app)
        own = new_check(state, body, app)
        for row in around.get("after", []): new_check(state, row, app)
        if around.get("rewrite"): own.update(around["rewrite"])
        return 201, own
    if method == "PATCH" and len(rest) == 2 and rest[0] == "check-runs":
        own = next((c for c in state["checks"] if str(c["id"]) == rest[1]), None)
        if own is None: return 404, "Not Found"
        if own["app"]["slug"] != app: return 403, "Invalid app_id `1` - check run can only be modified by the GitHub App that created it."
        for k in ("status", "conclusion", "output"):
            if k in body: own[k] = body[k]
        return 200, own
    if method == "GET" and len(rest) == 3 and rest[0] == "pulls" and rest[2] == "reviews":
        if rest[1] not in state["pulls"]: return 404, "Not Found"
        return 200, state["reviews"].get(rest[1], [])
    if method == "GET" and len(rest) == 3 and rest[:2] == ["pulls", "comments"]:
        c = state["comments"].get(rest[2]); return (200, c) if c else (404, "Not Found")
    if method == "GET" and len(rest) == 2 and rest[0] == "pulls":
        p = state["pulls"].get(rest[1]); return (200, p) if p else (404, "Not Found")
    if method == "GET" and len(rest) == 3 and rest[:2] == ["releases", "tags"]:
        r = state.setdefault("releases", {}).get(rest[2]); return (200, r) if r else (404, "Not Found")
    if method == "POST" and rest == ["releases"]:
        releases = state.setdefault("releases", {})
        if body["tag_name"] in releases: return 422, "Validation Failed"
        state["next_id"] = state.get("next_id", 1000) + 1
        releases[body["tag_name"]] = {**body, "id": state["next_id"]}; return 201, releases[body["tag_name"]]
    if method == "GET" and len(rest) == 3 and rest[0] == "collaborators" and rest[2] == "permission":
        p = state["permissions"].get(urllib.parse.unquote(rest[1]))
        return (200, {"permission": p, "user": {"login": rest[1]}}) if p else (404, "Not Found")
    return 404, "Not Found"


def main(argv: list) -> int:
    if argv[:1] != ["api"]: sys.stderr.write("stub gh: only `gh api` is stubbed\n"); return 2
    method, paginate, source, path, i = "GET", False, None, None, 1
    while i < len(argv):
        a = argv[i]
        if a in ("-X", "--method"): method = argv[i + 1]; i += 2
        elif a == "--paginate": paginate = True; i += 1
        elif a == "--input": source = argv[i + 1]; i += 2
        elif a.startswith("-"): sys.stderr.write(f"stub gh: {a} is not stubbed\n"); return 2
        elif path is None: path = a; i += 1
        else: sys.stderr.write(f"stub gh: a second path {a}\n"); return 2
    body = None
    if source is not None:
        with (sys.stdin if source == "-" else open(source)) as f: body = json.load(f)
    token = os.environ.get("GH_TOKEN", ""); state = load()
    record({"method": method, "path": path, "token": token, "body": body, "paginate": paginate})
    for f in state.get("fail", []):
        if f["method"] == method and path.startswith(f["path"]) and f.get("times", 1) > 0:
            f["times"] = f.get("times", 1) - 1
            if f.get("made") and state["tokens"].get(token) is not None:                  # done, and its answer lost
                route(state, method, path, body, state["tokens"][token])
            save(state); return error(f["status"], "Server Error")
    app = state["tokens"].get(token)
    if app is None: return error(401, "Bad credentials")
    status, out = route(state, method, path, body, app); save(state)
    if status >= 400: return error(status, out)
    sys.stdout.write(json.dumps(out)); return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
